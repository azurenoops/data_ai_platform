@page
@model OnboardingModel
@{
    ViewData["Title"] = "Onboarding";
}

<div class="row g-3">
    <div class="col-12">
        <h1 class="display-6">Onboarding Checklist</h1>
        <p class="text-muted">Use this sequence to validate a new environment and run a demo flow end-to-end.</p>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header">Checklist</div>
            <div class="card-body">
                <ol class="mb-0">
                    <li>Validate MCP health on the <a asp-page="/Index">Dashboard</a>.</li>
                    <li>Upload at least one source file on the <a asp-page="/Upload">Upload</a> page.</li>
                    <li>Trigger and monitor SQL ingestion on the <a asp-page="/SqlPipeline">SQL Pipeline</a> page.</li>
                    <li>Run MCP prompts from the runbook and confirm grounded answers.</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">Runbooks</div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><code>docs/MCP-DEMO-RUNBOOK.md</code></li>
                    <li><code>docs/DEPLOYMENT.md</code></li>
                    <li><code>docs/INGESTION.md</code></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">Token Troubleshooting</div>
            <div class="card-body">
                <p class="mb-1"><strong>Audience:</strong> @Model.McpAudience</p>
                <p class="mb-1"><strong>Tenant:</strong> @Model.TenantHint</p>
                <pre class="small mb-0">az login --tenant &lt;tenant-id&gt;
az account get-access-token --resource "@Model.McpAudience" --query accessToken -o tsv</pre>
            </div>
        </div>
    </div>
</div>
