@page
@model SourceCatalogModel
@{
    ViewData["Title"] = "Source Catalog";
}

<div class="row g-3">
    <div class="col-12">
        <h1 class="display-6">Source Catalog</h1>
        <p class="text-muted">Browse configured ingestion sources and structured datasets available to MCP tools.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="col-12">
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        </div>
    }

    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header">Sources (@Model.Sources.Count)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Docs</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in Model.Sources)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@source.Name</div>
                                        <div class="small text-muted">@source.Description</div>
                                    </td>
                                    <td>@source.DocumentCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header">Datasets (@Model.Datasets.Count)</div>
            <div class="card-body">
                @if (Model.Datasets.Count == 0)
                {
                    <div class="text-muted">No dataset metadata returned.</div>
                }
                else
                {
                    @foreach (var dataset in Model.Datasets)
                    {
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h2 class="h5 mb-1">@dataset.Name</h2>
                                    <div class="text-muted">@dataset.Description</div>
                                </div>
                                <span class="badge text-bg-secondary">@dataset.ViewName</span>
                            </div>

                            <div class="mt-3">
                                <div class="fw-semibold mb-1">Columns</div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Type</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var column in dataset.Columns)
                                            {
                                                <tr>
                                                    <td>@column.Name</td>
                                                    <td>@column.DataType</td>
                                                    <td>@column.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (dataset.SampleQuestions.Count > 0)
                            {
                                <div class="mt-2">
                                    <div class="fw-semibold mb-1">Sample questions</div>
                                    <ul class="mb-0">
                                        @foreach (var question in dataset.SampleQuestions)
                                        {
                                            <li>@question</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
