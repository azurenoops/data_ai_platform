<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PHWC Data + AI MCP Portal</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DataAiMcp.Portal.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="portal-orb portal-orb-left" aria-hidden="true"></div>
    <div class="portal-orb portal-orb-right" aria-hidden="true"></div>

    <header class="portal-header">
        <nav class="navbar navbar-expand-lg navbar-light mb-4 portal-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">PHWC MCP Portal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Upload">Upload</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/SourceCatalog">Source Catalog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Playground">Playground</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/OnboardingWizard">Wizard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/AclVisibility">ACL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Diagnostics">Diagnostics</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/SqlPipeline">SQL Pipeline</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Onboarding">Onboarding</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            var nameClaim = User.FindFirst("name")?.Value;
                            var upn = User.FindFirst("preferred_username")?.Value ?? User.Identity.Name ?? "";
                            string friendly;
                            if (!string.IsNullOrWhiteSpace(nameClaim) && !nameClaim.Contains('@'))
                            {
                                friendly = nameClaim;
                            }
                            else
                            {
                                var local = upn.Split('@')[0];
                                var words = local.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
                                friendly = string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
                                if (string.IsNullOrWhiteSpace(friendly))
                                {
                                    friendly = "User";
                                }
                            }

                            var tokens = friendly.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            string initials = tokens.Length switch
                            {
                                0 => "U",
                                1 => new string(tokens[0].Take(2).Select(char.ToUpperInvariant).ToArray()),
                                _ => $"{char.ToUpperInvariant(tokens[0][0])}{char.ToUpperInvariant(tokens[1][0])}",
                            };

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 portal-user" href="#"
                                   id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="portal-avatar">@initials</span>
                                    <span class="d-none d-lg-inline">@friendly</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li class="px-3 py-2">
                                        <div class="fw-semibold text-dark">@friendly</div>
                                        <div class="small text-muted text-break">@upn</div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">Sign out</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container portal-shell">
        <main role="main" class="pb-4 portal-content">
            @RenderBody()
        </main>
    </div>

    <footer class="footer portal-footer">
        <div class="container portal-footer-inner">
            <div class="portal-footer-brand">
                <span class="portal-footer-mark">PHWC</span>
                <span>Data&nbsp;+&nbsp;AI MCP Platform</span>
            </div>
            <div class="portal-footer-meta">
                <span>&copy; @DateTime.UtcNow.Year PHWC. All rights reserved.</span>
                <span class="portal-footer-dot" aria-hidden="true">&bull;</span>
                <span>Central US</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
