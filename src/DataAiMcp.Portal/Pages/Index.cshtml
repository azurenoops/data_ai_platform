@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="mx-auto max-w-[1040px] space-y-5 md:space-y-6">
    <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-5 shadow-sm backdrop-blur-sm md:p-6">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-tailspin-600">Operations</p>
        <h1 class="mt-2 text-4xl font-bold leading-tight text-tailspin-900 md:text-5xl">Platform Dashboard</h1>
        <p class="mt-2 max-w-3xl text-base text-slate-600">Operational status and quick links for ingestion and MCP validation.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card h-full ring-1 ring-white/60">
            <div class="card-header">MCP Health</div>
            <div class="card-body">
                @if (Model.IsMcpHealthy)
                {
                    <div class="alert alert-success mb-3">Healthy</div>
                }
                else
                {
                    <div class="alert alert-warning mb-3">Unavailable</div>
                }
                <dl class="space-y-2 text-[15px]">
                    <div><dt class="inline font-semibold text-tailspin-900">Base URL:</dt> <dd class="inline break-all text-slate-700">@Model.McpBaseUrl</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">Audience:</dt> <dd class="inline break-all text-slate-700">@Model.McpAudience</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">Detail:</dt> <dd class="inline text-slate-700">@Model.HealthDetail</dd></div>
                </dl>
            </div>
        </div>

        <div class="card h-full ring-1 ring-white/60">
            <div class="card-header">Environment</div>
            <div class="card-body">
                <dl class="space-y-2 text-[15px]">
                    <div><dt class="inline font-semibold text-tailspin-900">Subscription:</dt> <dd class="inline break-all text-slate-700">@Model.SubscriptionId</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">Resource Group:</dt> <dd class="inline text-slate-700">@Model.ResourceGroupName</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">Data Factory:</dt> <dd class="inline text-slate-700">@Model.DataFactoryName</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">SQL Pipeline:</dt> <dd class="inline text-slate-700">@Model.SqlPipelineName</dd></div>
                    <div><dt class="inline font-semibold text-tailspin-900">Landing Storage:</dt> <dd class="inline break-all text-slate-700">@Model.StorageAccountUrl/@Model.LandingContainerName</dd></div>
                </dl>
            </div>
        </div>
    </div>

    <div class="card ring-1 ring-white/60">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Diagnostic Status</span>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Diagnostics">Open Diagnostics</a>
            </div>
            <div class="card-body d-flex flex-wrap items-center gap-2">
                <span id="diag-mcp" class="badge text-bg-@(Model.DashboardMcpStatus.StartsWith("OK", StringComparison.OrdinalIgnoreCase) ? "success" : "warning") inline-flex items-center">MCP: @Model.DashboardMcpStatus</span>
                <span id="diag-catalog" class="badge text-bg-@(Model.DashboardCatalogStatus.StartsWith("OK", StringComparison.OrdinalIgnoreCase) ? "success" : "warning") inline-flex items-center">Catalog: @Model.DashboardCatalogStatus</span>
                <span id="diag-adf" class="badge text-bg-@(Model.DashboardDataFactoryStatus.StartsWith("OK", StringComparison.OrdinalIgnoreCase) || Model.DashboardDataFactoryStatus.StartsWith("Reachable", StringComparison.OrdinalIgnoreCase) ? "success" : "warning") inline-flex items-center">ADF: @Model.DashboardDataFactoryStatus</span>
                <span id="diag-refresh-ts" class="small ms-auto font-mono text-[0.75rem] uppercase tracking-[0.08em] text-slate-500">Refreshed at page load</span>
            </div>
        </div>

    <div class="card ring-1 ring-white/60">
            <div class="card-header">Quick Actions</div>
            <div class="card-body grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
                <a class="btn btn-outline-dark w-full text-start" asp-page="/SourceCatalog">Open Source Catalog</a>
                <a class="btn btn-outline-dark w-full text-start" asp-page="/Playground">Open MCP Playground</a>
                <a class="btn btn-outline-dark w-full text-start" asp-page="/OnboardingWizard">Open Source Wizard</a>
                <a class="btn btn-outline-dark w-full text-start" asp-page="/AclVisibility">Open ACL Panel</a>
                <a class="btn btn-outline-dark w-full text-start" asp-page="/Diagnostics">Open Diagnostics</a>
                <a class="btn btn-primary w-full text-start" asp-page="/Upload">Upload Source File</a>
                <a class="btn btn-outline-primary w-full text-start" asp-page="/SqlPipeline">Run SQL Demo Pipeline</a>
                <a class="btn btn-outline-secondary w-full text-start" asp-page="/Onboarding">Open Onboarding Checklist</a>
            </div>
        </div>
</section>

@section Scripts {
    <script>
        (() => {
            const statusUrl = '@Url.Page("/Index", "Status")';
            const mcpBadge = document.getElementById('diag-mcp');
            const catalogBadge = document.getElementById('diag-catalog');
            const adfBadge = document.getElementById('diag-adf');
            const refreshed = document.getElementById('diag-refresh-ts');

            function isGood(status) {
                const value = (status || '').toLowerCase();
                return value.startsWith('ok') || value.startsWith('reachable');
            }

            function setBadge(node, label, status) {
                if (!node) {
                    return;
                }

                node.classList.remove('text-bg-success', 'text-bg-warning');
                node.classList.add(isGood(status) ? 'text-bg-success' : 'text-bg-warning');
                node.textContent = `${label}: ${status}`;
            }

            async function refreshStatus() {
                try {
                    const response = await fetch(statusUrl, { credentials: 'same-origin' });
                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    setBadge(mcpBadge, 'MCP', payload.mcpStatus || 'Unknown');
                    setBadge(catalogBadge, 'Catalog', payload.catalogStatus || 'Unknown');
                    setBadge(adfBadge, 'ADF', payload.dataFactoryStatus || 'Unknown');

                    if (refreshed && payload.refreshedAtUtc) {
                        const when = new Date(payload.refreshedAtUtc);
                        refreshed.textContent = `Last refreshed ${when.toLocaleTimeString()}`;
                    }
                } catch {
                    // keep current values on transient refresh failures
                }
            }

            window.setInterval(refreshStatus, 60000);
        })();
    </script>
}
