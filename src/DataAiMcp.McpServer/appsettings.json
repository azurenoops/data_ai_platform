{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "TenantId": "",
    "Audience": "api://data-ai-mcp",
    "RequireAuthenticatedUser": true
  },
  "Storage": {
    "AccountName": "",
    "CuratedContainer": "curated"
  },
  "Search": {
    "Endpoint": "",
    "IndexName": "documents",
    "CmkKeyVaultUri": "",
    "CmkKeyName": "",
    "CmkKeyVersion": "",
    "SecondaryEndpoint": ""
  },
  "Foundry": {
    "Endpoint": "",
    "ProjectEndpoint": "",
    "ChatDeployment": "gpt-4o",
    "EmbeddingDeployment": "text-embedding-3-large"
  },
  "Synapse": {
    "ServerlessSqlEndpoint": "",
    "Database": "master",
    "MaxRows": 200,
    "QueryTimeoutSeconds": 30
  },
  "Datasets": [
    {
      "Name": "dataverse_account",
      "Description": "Dataverse Account table (CRM customers).",
      "ViewName": "vw_dataverse_account",
      "Columns": [
        { "Name": "accountid", "DataType": "uniqueidentifier", "Description": "Account primary key." },
        { "Name": "name", "DataType": "nvarchar(160)", "Description": "Display name." },
        { "Name": "revenue", "DataType": "decimal(18,2)", "Description": "Annual revenue." },
        { "Name": "modifiedon", "DataType": "datetime2", "Description": "Last modified timestamp." }
      ],
      "SampleQuestions": [
        "Top 10 accounts by revenue",
        "Accounts modified in the last 30 days"
      ]
    },
    {
      "Name": "sqlmi_orders",
      "Description": "Order header data exported nightly from SQL Managed Instance.",
      "ViewName": "vw_sqlmi_orders",
      "Columns": [
        { "Name": "orderid", "DataType": "bigint", "Description": "Order id." },
        { "Name": "customerid", "DataType": "bigint", "Description": "Customer foreign key." },
        { "Name": "orderdate", "DataType": "date", "Description": "Order date." },
        { "Name": "totalamount", "DataType": "decimal(18,2)", "Description": "Total order amount." }
      ],
      "SampleQuestions": [
        "Total revenue by month for the last 12 months",
        "Top 5 customers by total order amount"
      ]
    },
    {
      "Name": "afs_inventory",
      "Description": "Daily Azure Files inventory snapshot.",
      "ViewName": "vw_afs_inventory",
      "Columns": [
        { "Name": "share", "DataType": "nvarchar(200)", "Description": "Share name." },
        { "Name": "filepath", "DataType": "nvarchar(1024)", "Description": "Relative file path." },
        { "Name": "sizebytes", "DataType": "bigint", "Description": "File size in bytes." },
        { "Name": "snapshotdate", "DataType": "date", "Description": "Date of the snapshot." }
      ],
      "SampleQuestions": [
        "Largest files added in the last 7 days",
        "Total bytes per share"
      ]
    }
  ],
  "Sources": [
    { "Name": "sharepoint", "Description": "SharePoint document libraries surfaced via Microsoft Graph." },
    { "Name": "onedrive", "Description": "OneDrive for Business drives surfaced via Microsoft Graph." },
    { "Name": "afs", "Description": "Azure File Share drops landed via Data Factory." },
    { "Name": "sqlmi", "Description": "Azure SQL Managed Instance Parquet snapshots." },
    { "Name": "dataverse", "Description": "Dataverse tables surfaced via Synapse Link for Dataverse." }
  ]
}
